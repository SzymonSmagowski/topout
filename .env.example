# Workspace-root env used ONLY by `pnpm seed` (scripts/seed.ts).
#
# Real values live in `apps/topout/.env`, which is gitignored. This file is
# committed so a fresh clone can see what variables exist without exposing
# values. The repo is public — never put secrets in this file.

# Convex deployment URL — get from `pnpm convex:dev`'s first-run prompt or
# from the Convex dashboard.
CONVEX_URL=https://<your-dev-deployment>.convex.cloud

# Admin key for ConvexHttpClient.setAdminAuth. Get via
# `pnpm convex:dev` then `npx convex auth print-admin-key` (or the dashboard).
CONVEX_DEPLOY_KEY=convex-dev-key-...

# Optional client-side prod guard. If your deployment isn't prefixed `dev:` /
# `local:`, set the name here (comma-separated allowlist) to bypass the
# refusal. The Convex action's `assertNonProd` is the authoritative check.
# ALLOWED_SEED_DEPLOYMENTS=

# Convenience — defaults inside the seed (override per CLI flag).
# RNG_SEED=42
# SEED_USER_PASSWORD=seed-demo-pw
