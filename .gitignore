# top-level workspace gitignore for the topout repo (public).

# env — NEVER commit
.env
.env.*
!.env.example
!.env.local.example

# node — match dirs AND symlinks (convex/node_modules is a symlink to frontend/node_modules)
node_modules
.pnp.*

# Convex local-dev artifacts
.convex-tmp/
frontend/.convex/

# turbo / build caches
.turbo/

# OS
.DS_Store

# IDE
.vscode/
.idea/
