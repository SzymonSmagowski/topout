<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram name="llm-flows" id="llm-flows">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============================================================== -->
        <!-- TITLE                                                          -->
        <!-- ============================================================== -->
        <mxCell id="title" value="TopOut — LLM LangGraph Flows" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two graphs running on the same sidecar. Each node = one Langfuse observation. Synthesize node attaches the Langfuse CallbackHandler to ChatOpenAI." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#525252;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1600" height="20" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- LAYOUT PLAN                                                    -->
        <!-- Two vertical pipelines side by side.                           -->
        <!-- Left  column (x=200,  width=320) = /summarize-session          -->
        <!-- Right column (x=900,  width=320) = /weekly-report              -->
        <!-- Edge labels sit between columns (x=540..780) or in the outer   -->
        <!-- right gutter (x=1260+). Never inside any box.                  -->
        <!-- ============================================================== -->

        <!-- ============================================================== -->
        <!-- COLUMN HEADERS                                                 -->
        <!-- ============================================================== -->
        <mxCell id="h-summarize" value="POST /summarize-session" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;fontColor=#A0522D;" vertex="1" parent="1">
          <mxGeometry x="200" y="90" width="320" height="28" as="geometry" />
        </mxCell>
        <mxCell id="h-weekly" value="POST /weekly-report" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;fontColor=#A0522D;" vertex="1" parent="1">
          <mxGeometry x="900" y="90" width="320" height="28" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- EDGES — summarize-session (back layer)                         -->
        <!-- ============================================================== -->

        <!-- START -> load_payload -->
        <mxCell id="es-start-load" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F3864;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="s-start" target="s-load">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es-start-load-l" value="state init" style="edgeLabel;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FAF7F0;" vertex="1" connectable="0" parent="es-start-load">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- load_payload -> format_prompt -->
        <mxCell id="es-load-fmt" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0522D;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="s-load" target="s-fmt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es-load-fmt-l" value="state.request : SummarizeSessionRequest" style="edgeLabel;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#A0522D;labelBackgroundColor=#FAF7F0;" vertex="1" connectable="0" parent="es-load-fmt">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- format_prompt -> synthesize -->
        <mxCell id="es-fmt-syn" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0522D;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="s-fmt" target="s-syn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es-fmt-syn-l" value="state.user_payload : dict" style="edgeLabel;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#A0522D;labelBackgroundColor=#FAF7F0;" vertex="1" connectable="0" parent="es-fmt-syn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- synthesize -> END -->
        <mxCell id="es-syn-end" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F3864;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="s-syn" target="s-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es-syn-end-l" value="state.text, state.usage" style="edgeLabel;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FAF7F0;" vertex="1" connectable="0" parent="es-syn-end">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ============================================================== -->
        <!-- EDGES — weekly-report (back layer)                             -->
        <!-- ============================================================== -->

        <!-- START -> load_payload -->
        <mxCell id="ew-start-load" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F3864;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="w-start" target="w-load">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ew-start-load-l" value="state init" style="edgeLabel;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FAF7F0;" vertex="1" connectable="0" parent="ew-start-load">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- load_payload -> analyze_stats -->
        <mxCell id="ew-load-anly" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0522D;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="w-load" target="w-anly">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ew-load-anly-l" value="state.request : WeeklyReportRequest" style="edgeLabel;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#A0522D;labelBackgroundColor=#FAF7F0;" vertex="1" connectable="0" parent="ew-load-anly">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- analyze_stats -> synthesize_narrative -->
        <mxCell id="ew-anly-syn" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0522D;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="w-anly" target="w-syn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ew-anly-syn-l" value="state.stats : WeeklyReportStats (pandas)" style="edgeLabel;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#A0522D;labelBackgroundColor=#FAF7F0;" vertex="1" connectable="0" parent="ew-anly-syn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- synthesize_narrative -> END -->
        <mxCell id="ew-syn-end" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F3864;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="w-syn" target="w-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ew-syn-end-l" value="state.narrative_md, state.usage" style="edgeLabel;html=1;align=left;fontSize=11;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FAF7F0;" vertex="1" connectable="0" parent="ew-syn-end">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ============================================================== -->
        <!-- NODES — summarize-session (front layer)                        -->
        <!-- Centered on x=360, width=320 (x=200..520)                      -->
        <!-- ============================================================== -->

        <mxCell id="s-start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1F3864;fontSize=14;fontFamily=Helvetica;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="80" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s-load" value="load_payload&#xa;&#xa;No-op gate. Pydantic validated&#xa;at the route boundary.&#xa;&#xa;reads:  state.request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9C6500;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="240" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="s-fmt" value="format_prompt&#xa;&#xa;Build the JSON dict the LLM sees&#xa;as the user message.&#xa;&#xa;reads:  state.request&#xa;writes: state.user_payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2E7D32;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="440" width="320" height="160" as="geometry" />
        </mxCell>

        <mxCell id="s-syn" value="synthesize&#xa;&#xa;llm.summarize_session()&#xa;ChatOpenAI.invoke with Langfuse&#xa;CallbackHandler in config.&#xa;Returns ≤ 240 chars of plain text.&#xa;&#xa;reads:  state.user_payload, callbacks&#xa;writes: state.text, state.usage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6A1B9A;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="660" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="s-end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1F3864;fontSize=14;fontFamily=Helvetica;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="920" width="80" height="50" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- NODES — weekly-report (front layer)                            -->
        <!-- Centered on x=1060, width=320 (x=900..1220)                    -->
        <!-- ============================================================== -->

        <mxCell id="w-start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1F3864;fontSize=14;fontFamily=Helvetica;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="140" width="80" height="50" as="geometry" />
        </mxCell>

        <mxCell id="w-load" value="load_payload&#xa;&#xa;No-op gate. Pydantic validated&#xa;at the route boundary.&#xa;&#xa;reads:  state.request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9C6500;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="240" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="w-anly" value="analyze_stats&#xa;&#xa;pandas DataFrame over sessions + attempts.&#xa;sends_count, top_grade, send_rate,&#xa;gyms_visited, longest_send_streak,&#xa;deltas vs prior-week / baseline.&#xa;&#xa;reads:  state.request&#xa;writes: state.stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2E7D32;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="440" width="320" height="160" as="geometry" />
        </mxCell>

        <mxCell id="w-syn" value="synthesize_narrative&#xa;&#xa;llm.synthesize_weekly_narrative()&#xa;ChatOpenAI.invoke with Langfuse&#xa;CallbackHandler in config.&#xa;Returns 200-400 words of markdown.&#xa;&#xa;reads:  state.stats, state.request, callbacks&#xa;writes: state.narrative_md, state.usage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6A1B9A;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="660" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="w-end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1F3864;fontSize=14;fontFamily=Helvetica;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="920" width="80" height="50" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- SIDE CALLOUT — Langfuse wiring (right gutter)                   -->
        <!-- ============================================================== -->

        <mxCell id="lf-box" value="Langfuse wiring&#xa;&#xa;observability/langfuse.py exposes:&#xa;  • get_langfuse_client() -&gt; Langfuse | None&#xa;  • get_callback_handler() -&gt; CallbackHandler | None&#xa;&#xa;Routes wrap the graph in:&#xa;  propagate_attributes(&#xa;     user_id=req.user_id,&#xa;     session_id=req.session_id,&#xa;     tags=[settings.langfuse_environment],&#xa;  )&#xa;&#xa;Both are None when LANGFUSE_PUBLIC_KEY /&#xa;LANGFUSE_SECRET_KEY are empty — graceful&#xa;no-op for local dev / CI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6A1B9A;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="240" width="380" height="360" as="geometry" />
        </mxCell>

        <!-- LLM client callout - below Langfuse, in the right gutter -->
        <mxCell id="llm-box" value="llm/client.py — single LLM SDK import&#xa;&#xa;langchain_openai.ChatOpenAI(model, api_key, timeout=30)&#xa;summarize_session(prompt, payload, max_chars, callbacks)&#xa;synthesize_weekly_narrative(prompt, payload, max_chars, callbacks)&#xa;&#xa;Public return: LlmOk | LlmErr (discriminated on .kind).&#xa;Token usage extracted from response.usage_metadata." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9C6500;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1280" y="660" width="380" height="200" as="geometry" />
        </mxCell>

        <!-- Failure modes — below the pipelines (full-width) -->
        <mxCell id="fail-box" value="Failure handling (sync HTTP boundary)&#xa;&#xa;• Pydantic validation error in load_payload                 -&gt; FastAPI 422.&#xa;• Pandas KeyError or empty-frame in analyze_stats           -&gt; route maps RuntimeError to 502.&#xa;• OpenAI / ChatOpenAI error in synthesize / synthesize_narrative -&gt; same.&#xa;Convex action wraps the fetch in try/catch and stores the message in&#xa;weeklyReports.error or sessions.summaryError, sets status='err'.&#xa;Never leaves 'pending'." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#A0522D;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1620" height="170" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
