<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram name="weekly-report-graph" id="weekly-report-graph">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============================================================== -->
        <!-- TITLE                                                          -->
        <!-- ============================================================== -->
        <mxCell id="title" value="TopOut — Weekly Report LangGraph Topology" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="3-node linear pipeline. Single typed Pydantic state (WeeklyReportState) passed through every node. No dict[str, Any]; no router; no retry loop in v1." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#525252;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1300" height="20" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- EDGES (back layer)                                             -->
        <!-- Layout: vertical pipeline; arrows are short vertical segments  -->
        <!-- between stacked boxes. Labels sit to the RIGHT of the arrow    -->
        <!-- in the open right gutter — never inside any box.               -->
        <!-- ============================================================== -->

        <!-- START -> load_payload (vertical, short) -->
        <mxCell id="e-start-load" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F3864;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="n-start" target="n-load">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-start-load-l" value="state init" style="edgeLabel;html=1;align=left;fontSize=12;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FAF7F0;" vertex="1" connectable="0" parent="e-start-load">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- load_payload -> analyze_stats -->
        <mxCell id="e-load-analyze" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0522D;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="n-load" target="n-analyze">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-load-analyze-l" value="state.request : WeeklyReportRequest&#xa;(validated Pydantic v2)" style="edgeLabel;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=#A0522D;labelBackgroundColor=#FAF7F0;spacingLeft=4;" vertex="1" connectable="0" parent="e-load-analyze">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- analyze_stats -> synthesize_narrative -->
        <mxCell id="e-analyze-synth" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0522D;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="n-analyze" target="n-synth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-analyze-synth-l" value="state.stats : WeeklyReportStats&#xa;(pandas-derived)" style="edgeLabel;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=#A0522D;labelBackgroundColor=#FAF7F0;spacingLeft=4;" vertex="1" connectable="0" parent="e-analyze-synth">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- synthesize_narrative -> END -->
        <mxCell id="e-synth-end" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F3864;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FAF7F0;" edge="1" parent="1" source="n-synth" target="n-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-synth-end-l" value="state.narrative_md, state.usage" style="edgeLabel;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FAF7F0;spacingLeft=4;" vertex="1" connectable="0" parent="e-synth-end">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ============================================================== -->
        <!-- NODES (front layer)                                            -->
        <!-- Vertical stack centered on x=300. Each node 360px wide.        -->
        <!-- Right gutter starts at x=720 — that's where edge labels sit.   -->
        <!-- ============================================================== -->

        <!-- START -->
        <mxCell id="n-start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1F3864;fontSize=14;fontFamily=Helvetica;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- load_payload -->
        <mxCell id="n-load" value="load_payload&#xa;&#xa;Validate inbound JSON against&#xa;WeeklyReportRequest (Pydantic).&#xa;Coerce types; reject malformed.&#xa;&#xa;reads:  raw POST body&#xa;writes: state.request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9C6500;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="360" height="170" as="geometry" />
        </mxCell>

        <!-- analyze_stats -->
        <mxCell id="n-analyze" value="analyze_stats&#xa;&#xa;pandas DataFrame over sessions + attempts.&#xa;Compute: sends_count, top_grade, send_rate,&#xa;total_attempts, gyms_visited, longest_send_streak,&#xa;send_rate_delta_prev_week, send_rate_delta_baseline,&#xa;top_grade_delta.&#xa;&#xa;reads:  state.request&#xa;writes: state.stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2E7D32;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="450" width="360" height="220" as="geometry" />
        </mxCell>

        <!-- synthesize_narrative -->
        <mxCell id="n-synth" value="synthesize_narrative&#xa;&#xa;Call llm.synthesize_weekly_narrative()&#xa;with SYSTEM_PROMPT + state.stats.&#xa;Returns 200-400 words of markdown.&#xa;Track usage (tokens, model, duration).&#xa;&#xa;reads:  state.stats, state.request&#xa;writes: state.narrative_md, state.usage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6A1B9A;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="730" width="360" height="200" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="n-end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1F3864;fontSize=14;fontFamily=Helvetica;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="990" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- SIDE CALLOUTS (right gutter)                                    -->
        <!-- Positioned beside the relevant nodes, OUTSIDE arrow label space.-->
        <!-- ============================================================== -->

        <!-- State callout — beside load_payload -->
        <mxCell id="state-box" value="WeeklyReportState (Pydantic v2)&#xa;&#xa;request: WeeklyReportRequest | None&#xa;stats:   WeeklyReportStats   | None&#xa;narrative_md: str | None&#xa;usage:   LlmUsage           | None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontFamily=Courier New;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="220" width="430" height="170" as="geometry" />
        </mxCell>

        <!-- LLM client callout — beside synthesize -->
        <mxCell id="llm-box" value="llm/client.py — provider isolation point&#xa;&#xa;synthesize_weekly_narrative(prompt, payload) -&gt; LlmResult&#xa;Reads OPENAI_API_KEY + OPENAI_MODEL (default gpt-5.4-nano).&#xa;Mirror signature of convex/llm/client.ts on the TS side.&#xa;Vertex AI swap: replace this body; callers unchanged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6A1B9A;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="730" width="500" height="200" as="geometry" />
        </mxCell>

        <!-- Prompt callout — beside analyze_stats -->
        <mxCell id="prompt-box" value="Prompt source: sidecar/src/llm/prompts/weekly_report.py&#xa;&#xa;SYSTEM_PROMPT instructs:&#xa;  • opener:     volume / quality framing&#xa;  • highlight:  specific best moment of the week&#xa;  • trend:      vs prior 7d + vs 30d baseline&#xa;  • suggestion: 1 specific actionable for next week&#xa;Constraints: 200-400 words, markdown, no emoji." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#9C6500;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="450" width="500" height="220" as="geometry" />
        </mxCell>

        <!-- Failure modes — below the pipeline (full-width) -->
        <mxCell id="fail-box" value="Failure handling (sync HTTP boundary)&#xa;&#xa;• Pydantic validation error in load_payload → FastAPI 422.&#xa;• Pandas KeyError or empty-frame in analyze_stats → 500 with { error }.&#xa;• OpenAI error in synthesize_narrative → 500 with { error }.&#xa;Convex action wraps the fetch in try/catch and stores the message in weeklyReports.error, sets status='err'. Never leaves 'pending'." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#A0522D;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="1240" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
