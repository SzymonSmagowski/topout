# Convex deployment URL. Get from `npx convex dev`'s first-run prompt or the
# Convex dashboard. Looks like https://fluffy-otter-42.convex.cloud.
NEXT_PUBLIC_CONVEX_URL=https://your-dev-deployment.convex.cloud

# Sidecar URL probed by the /reports page's health banner.
# Use http://host.docker.internal:8000 inside the devcontainer.
NEXT_PUBLIC_PYTHON_SIDECAR_URL=http://localhost:8000
