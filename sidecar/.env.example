# Server
PORT=8000
LOG_LEVEL=info

# Auth — MUST match the Convex env var SIDECAR_SECRET (set via `npx convex env set`).
# Generate one: openssl rand -hex 32
SIDECAR_SECRET=replace-with-the-same-secret-you-set-on-the-convex-side

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.4-nano

# ---------------------------------------------------------------------------
# Langfuse — observability for every LLM call + every graph node.
#
# Leave the keys empty to disable tracing entirely (sidecar still runs).
#
# Local dev:
#   1. Open http://localhost:3001 (login: dev@example.com / devpassword)
#   2. Create org + project "topout-sidecar"
#   3. Settings → API keys → copy the pair below
#
# Cloud (per the project_langfuse_per_app_isolation memory):
#   `scripts/provision-langfuse-org.sh topout-sidecar` mints the org +
#   project + keys and writes them straight into the per-app Secret
#   Manager — never paste into a committed file.
# ---------------------------------------------------------------------------
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
